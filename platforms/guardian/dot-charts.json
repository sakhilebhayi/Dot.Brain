{
  "platform": "dot-charts",
  "health_url": "https://charts.infodot.co.za/guardian/health",
  "token_env": "DOT_CHARTS_GUARDIAN_TOKEN",
  "repo": "sakhilebhayi/Dot.Charts",
  "default_branch": "main",
  "deploy": {
    "workflow": "deploy.yml",
    "confirm_inputs": {
      "confirm": "deploy"
    }
  },
  "autonomy_level": 2,
  "environment": "production",
  "poll_interval_s": 300,
  "protected_areas": [
    "backend/database/migrations/**",
    "blupin/**"
  ]
}
