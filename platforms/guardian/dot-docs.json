{
  "platform": "dot-docs",
  "health_url": "https://doc.infodot.co.za/guardian/health",
  "token_env": "DOT_DOCS_GUARDIAN_TOKEN",
  "repo": "sakhilebhayi/Dot.docs",
  "default_branch": "main",
  "deploy": {
    "workflow": "deploy.yml",
    "confirm_inputs": {
      "confirm": "deploy"
    }
  },
  "autonomy_level": 2,
  "environment": "production",
  "poll_interval_s": 300,
  "protected_areas": [
    "database/migrations/**",
    "app/Policies/**"
  ]
}
