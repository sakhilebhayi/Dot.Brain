{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dot.brain/schemas/brand-analysis.schema.json",
  "title": "Brand Experience Analysis",
  "description": "The output of `brand-engine analyze`: the evidence the registered checks and the supplied tool reports produced, every finding, and an explicit list of what was not measured. It carries no clock, no absolute path and no environment value, so the same checkout and reports give the same bytes. `integrity.sha256` is the canonical hash of the rest of the document; `plan` and `verify` refuse a document whose hash no longer matches. `evidence` rows are the input to `evidence assemble`, which turns them into the evidence file `score` takes (schemas/brand-evidence.schema.json).",
  "type": "object",
  "required": ["analysis_version", "engine_version", "input", "rubric", "profile", "themes", "checks", "evidence", "findings", "not_measured", "conflicts", "coverage", "reports", "engine_problems", "counts", "integrity"],
  "additionalProperties": false,
  "properties": {
    "analysis_version": { "const": "1.0.0" },
    "engine_version": { "type": "string", "minLength": 1, "maxLength": 20 },
    "input": {
      "type": "object",
      "required": ["repo", "commit", "commit_source"],
      "additionalProperties": false,
      "properties": {
        "repo": { "description": "A string, or null when unknown (checked by the loader)." },
        "commit": { "description": "A string, or null when unknown (checked by the loader)." },
        "commit_source": { "enum": ["git", "flag", "none"] },
        "scope": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "kind", "version", "effective_status", "chain", "sha256", "source", "domain_overrides", "principle_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 40 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "effective_status": { "enum": ["draft", "proposed", "ratified", "superseded"] },
        "chain": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": { "enum": ["registry", "file"] },
        "domain_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["principle", "yields_to", "reason"],
            "additionalProperties": false,
            "properties": {
              "principle": { "type": "string", "pattern": "^BXP-[0-9]{2}$" },
              "yields_to": { "enum": ["domain_safety", "regulation", "accessibility", "security", "functional_correctness"] },
              "reason": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "principle_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["principle", "via", "non_negotiable"],
            "additionalProperties": false,
            "properties": {
              "principle": { "type": "string", "pattern": "^BXP-[0-9]{2}$" },
              "via": { "type": "string", "maxLength": 200 },
              "non_negotiable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "themes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dimension", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^d[0-9]{1,2}\\.[a-z0-9_]+$" },
          "dimension": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
          "title": { "type": "string", "maxLength": 120 },
          "status": { "enum": ["measured", "not_applicable", "not_measured"] },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "additionalProperties": false,
            "properties": {
              "code": { "enum": ["timeout", "out_of_memory", "invalid_module", "invalid_result", "crashed", "threw"] },
              "message": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "source_class", "result", "value", "artifact_ref", "origin"],
        "additionalProperties": false,
        "properties": {
          "check_id": { "type": "string", "pattern": "^d[0-9]{1,2}\\.[a-z0-9_]+$" },
          "source_class": { "const": "automated_check" },
          "result": { "enum": ["pass", "fail", "partial"] },
          "value": { "type": "number", "minimum": 0, "maximum": 1 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "artifact_ref": { "type": "string", "pattern": "^[^\\s]{1,300}$" },
          "origin": { "type": "string", "pattern": "^(check|adapter):[^\\s]{1,100}$" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fingerprint", "source_id", "severity", "dimension", "check_id", "message", "fix_hint", "origin"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{12}(\\.[0-9]+)?$" },
          "source_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" },
          "severity": { "enum": ["blocker", "major", "minor", "info"] },
          "dimension": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
          "check_id": { "type": "string", "pattern": "^d[0-9]{1,2}\\.[a-z0-9_]+$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 },
          "fix_hint": { "type": "string", "maxLength": 500 },
          "location": {
            "type": "object",
            "required": ["file"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "minLength": 1, "maxLength": 300 },
              "line": { "type": "integer", "minimum": 1 }
            }
          },
          "origin": { "type": "string", "minLength": 1, "maxLength": 120 },
          "engine": { "const": true },
          "kind": { "enum": ["wcag_failure", "unsupported_claim", "failing_test", "domain_override_violation", "ethics_gate_flag"] },
          "wcag_level": { "enum": ["A", "AA", "AAA"] },
          "wcag_criterion": { "type": "string", "pattern": "^[0-9]\\.[0-9]{1,2}\\.[0-9]{1,2}$" },
          "principle": { "type": "string", "pattern": "^BXP-[0-9]{2}$" }
        }
      }
    },
    "not_measured": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "dimension", "reason"],
        "additionalProperties": false,
        "properties": {
          "check_id": { "type": "string", "pattern": "^d[0-9]{1,2}\\.[a-z0-9_]+$" },
          "dimension": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
          "reason": { "enum": ["no_check_registered", "no_report_supplied", "report_had_no_data", "not_applicable", "check_not_measured", "check_errored", "conflicting_sources"] },
          "adapters": { "type": "array", "items": { "type": "string", "maxLength": 40 } }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "origins"],
        "additionalProperties": false,
        "properties": {
          "check_id": { "type": "string", "pattern": "^d[0-9]{1,2}\\.[a-z0-9_]+$" },
          "origins": { "type": "array", "items": { "type": "string", "maxLength": 120 } }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["skipped", "skipped_total"],
      "additionalProperties": false,
      "properties": {
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "additionalProperties": false,
            "properties": { "path": { "type": "string", "maxLength": 300 }, "reason": { "type": "string", "maxLength": 60 } }
          }
        },
        "skipped_total": { "type": "integer", "minimum": 0 }
      }
    },
    "reports": {
      "type": "object",
      "required": ["ingested", "skipped", "superseded", "notes"],
      "additionalProperties": false,
      "properties": {
        "ingested": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "adapter", "sha256", "bytes"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "maxLength": 200 },
              "adapter": { "enum": ["detector", "axe", "lighthouse", "tests"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "reason"],
            "additionalProperties": false,
            "properties": { "file": { "type": "string", "maxLength": 200 }, "reason": { "type": "string", "maxLength": 200 } }
          }
        },
        "superseded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check_id", "origin", "superseded_by"],
            "additionalProperties": false,
            "properties": {
              "check_id": { "type": "string", "pattern": "^d[0-9]{1,2}\\.[a-z0-9_]+$" },
              "origin": { "type": "string", "maxLength": 120 },
              "superseded_by": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "engine_problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "message"],
        "additionalProperties": false,
        "properties": { "file": { "type": "string", "maxLength": 300 }, "message": { "type": "string", "maxLength": 300 } }
      }
    },
    "counts": {
      "type": "object",
      "required": ["checks", "evidence", "findings", "by_severity", "not_measured", "redactions"],
      "additionalProperties": false,
      "properties": {
        "checks": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "required": ["blocker", "major", "minor", "info"],
          "additionalProperties": false,
          "properties": {
            "blocker": { "type": "integer", "minimum": 0 }, "major": { "type": "integer", "minimum": 0 },
            "minor": { "type": "integer", "minimum": 0 }, "info": { "type": "integer", "minimum": 0 }
          }
        },
        "not_measured": { "type": "integer", "minimum": 0 },
        "redactions": { "type": "integer", "minimum": 0 },
        "findings_truncated": { "const": true }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["sha256"],
      "additionalProperties": false,
      "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    }
  }
}
