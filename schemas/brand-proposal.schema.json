{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dot.brain/schemas/brand-proposal.schema.json",
  "title": "Brand Governance Proposal",
  "description": "A proposed change to a brand profile, a framework principle, the BXQS rubric or the brand doctrine (ADR-0024). It borrows DKP's vocabulary (contributors, evidence classes, confidence) and is NOT a signed Knowledge Pack. The status lifecycle is draft, proposed, ratified: only a human ever reaches ratified, and no engine command writes it. Cross-field rules (the status history, evidence classes, citation verification, version arithmetic, the target's current state, precedence) are enforced by services/brand-engine (lint-proposal), not expressible here. This file defines the shape only.",
  "type": "object",
  "required": ["format", "id", "title", "status", "target", "change", "rationale", "evidence", "confidence", "affected_products", "risk", "rollback", "precedence", "changelog_entry", "author", "created_at", "history"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "format": { "const": "brand-proposal/1" },
    "id": { "type": "string", "pattern": "^BRP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{2,60}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["draft", "proposed", "ratified"] },
    "target": {
      "type": "object",
      "required": ["kind", "id", "change_kind", "edit_mode", "to_version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["profile", "principle", "rubric", "doctrine"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "change_kind": { "enum": ["new", "amend"] },
        "edit_mode": { "enum": ["new_version", "in_place"] },
        "from_version": { "$ref": "#/$defs/semver" },
        "to_version": { "$ref": "#/$defs/semver" },
        "base_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "engagement_related": { "type": "boolean" }
      }
    },
    "change": {
      "type": "object",
      "required": ["summary", "details", "weakens_precedence"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "after"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string", "minLength": 1, "maxLength": 200 },
              "before": { "type": "string", "maxLength": 2000 },
              "after": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        },
        "weakens_precedence": { "type": "boolean" },
        "rubric_change_type": { "enum": ["dimension_set_weight_or_cap", "checks_metrics_floors_policy", "wording"] }
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "affected_products": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,60}$" } },
    "risk": {
      "type": "object",
      "required": ["level", "description", "ethics_review"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["low", "medium", "high"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "ethics_review": { "enum": ["not_needed", "required"] }
      }
    },
    "rollback": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "precedence": {
      "type": "object",
      "required": ["acknowledged", "conflicts"],
      "additionalProperties": false,
      "properties": {
        "acknowledged": { "type": "boolean" },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concern", "description", "resolution"],
            "additionalProperties": false,
            "properties": {
              "concern": { "enum": ["safety", "regulation", "accessibility", "security", "functional_correctness"] },
              "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "resolution": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        }
      }
    },
    "changelog_entry": {
      "type": "object",
      "required": ["version", "date", "summary"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "date": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "author": { "$ref": "#/$defs/contributor" },
    "contributors": { "type": "array", "items": { "$ref": "#/$defs/contributor" } },
    "created_at": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status", "at", "actor"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["draft", "proposed", "ratified"] },
          "at": { "type": "string", "format": "date-time" },
          "actor": {
            "type": "object",
            "required": ["id", "kind"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["human", "ai"] }
            }
          }
        }
      }
    },
    "approver": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "ai"] },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "ratified_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "contributor": {
      "type": "object",
      "required": ["id", "kind", "display_name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "ai"] },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": ["class", "summary"],
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "class": { "enum": ["documented_research", "observed_behaviour", "internal_hypothesis", "validated_finding", "declared_intent"] },
        "summary": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "citation_verified": { "type": "boolean" },
        "verified_by": {
          "type": "object",
          "required": ["id", "kind"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["human", "ai"] }
          }
        },
        "verified_at": { "type": "string", "format": "date-time" },
        "n": { "type": "integer", "minimum": 1 },
        "method": { "type": "string", "minLength": 1 },
        "experiment_ref": { "type": "string", "minLength": 1 },
        "declared_by": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
